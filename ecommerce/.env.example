# -----------------------------------------------------------------------------
# Compose / application
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=multi-vendor-ai-ecommerce
APP_ENV=development
NGINX_HTTP_PORT=8080
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-random-value-of-at-least-50-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_REQUEST_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# External PostgreSQL (there is intentionally no PostgreSQL Compose service)
# -----------------------------------------------------------------------------
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=multi_vendor_ecommerce
POSTGRES_USER=ecommerce_app
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# Redis / Celery / Channels
# -----------------------------------------------------------------------------
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNEL_LAYER_URL=redis://redis:6379/3
CELERY_LOG_LEVEL=INFO
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=270

# -----------------------------------------------------------------------------
# JWT / authentication
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=true
JWT_BLACKLIST_AFTER_ROTATION=true
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_PATH=/api/v1/auth/
JWT_REFRESH_COOKIE_DOMAIN=
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_HOURS=24
AUTH_RATE_LIMIT=5/minute
TEST_USE_SQLITE=false

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Local default prints email content to the backend/Celery logs.
# For Gmail SMTP, use smtp.EmailBackend, smtp.gmail.com, port 587, TLS=true,
# and a Google App Password. Keep the real password only in the ignored .env file.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_TIMEOUT_SECONDS=30
DEFAULT_FROM_EMAIL=no-reply@example.com

# -----------------------------------------------------------------------------
# Frontend / public URLs
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8080
BACKEND_PUBLIC_URL=http://localhost:8080
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/ws
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# Uploads / object storage (local values are used until storage is integrated)
# -----------------------------------------------------------------------------
MEDIA_ROOT=/app/media
MAX_IMAGE_UPLOAD_MB=10
MAX_AVATAR_UPLOAD_MB=5
MAX_SHOP_IMAGE_UPLOAD_MB=10
MAX_SELLER_DOCUMENT_UPLOAD_MB=10
SELLER_DOCUMENT_LINK_MAX_AGE_SECONDS=300
MAX_VIDEO_UPLOAD_MB=100
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/webm
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# -----------------------------------------------------------------------------
# AIService — B4/B5
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=1536
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=3
AI_CACHE_TTL_SECONDS=3600
AI_FEATURES_ENABLED=true
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Payment — B6 (COD + VNPay Sandbox)
# -----------------------------------------------------------------------------
PAYMENT_DEFAULT_GATEWAY=vnpay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:8080/payment/result
VNPAY_IPN_URL=https://replace-with-public-url.example/api/v1/payment/callback/vnpay
VNPAY_LOCALE=vn
VNPAY_CURRENCY=VND

# -----------------------------------------------------------------------------
# Optional observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
